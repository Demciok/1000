  "zh": [
    {"id": 1, "text": "-------英雄们的荣耀榜-------"},
    {"id": 2, "text": "{player.name} - {player.points} 个悲剧点数"},
    {"id": 3, "text": "今天的祭品是: {player.name}"},
    {"id": 4, "text": "赢得拍卖的废物获得牌: {cards}"},
    {"id": 5, "text": "开始竞价，请准备好你们的眼泪"},
    {"id": 6, "text": "倒霉鬼 {winner.name} 必须赢得 {highest_bid} 分，祝你好运哈哈"},
    {"id": 7, "text": "游戏开始，愿神保佑你们"},
    {"id": 8, "text": "新一轮开始，再次受苦吧"},
    {"id": 9, "text": "这一轮的幸运儿是 {trick_winner.name}，其余人可以哭了"},
    {"id": 10, "text": "{player.name} 获得了 {round_score} 个无用的点数"},
    {"id": 11, "text": "游戏结束，人类冠军是 {player.name}，其他人可以回家睡觉了"},
    {"id": 12, "text": "机器人 {bot.name} 提高赌注，人类颤抖吧！"},
    {"id": 13, "text": "机器人 {bot.name} 结束竞价，人类松了口气"},
    {"id": 14, "text": "{bot.name} 扔出了 {card.name}，就像扔垃圾一样"},
    {"id": 15, "text": "{bot.name} 把 {picked} 送给了可怜的 {recipient.name}"},
    {"id": 16, "text": "你的手牌，请欣赏这场灾难"},
    {"id": 17, "text": "红心（真爱）: {cards}"},
    {"id": 18, "text": "铃铛（钱）: {cards}"},
    {"id": 19, "text": "橡子（松鼠的食物）: {cards}"},
    {"id": 20, "text": "叶子（大自然）: {cards}"},
    {"id": 21, "text": "玩家大人 {player.name}，请您驾到"},
    {"id": 22, "text": "竞价进行中，你敢加10吗？当前最高赌注 {current_rate}，懦夫"},
    {"id": 23, "text": "你必须给每个对手一张牌，分享你的痛苦"},
    {"id": 24, "text": "牌号不对，你连数数都不会吗？再试一次。"},
    {"id": 25, "text": "请输入整数！你在输入什么鬼东西！"},
    {"id": 26, "text": "游戏已保存，你的失败被永久记录了"},
    {"id": 27, "text": "游戏已加载，准备好继续受苦！"},
    {"id": 28, "text": "欢迎来到1000纸牌游戏，这是来自波兰共产主义时代的古老折磨"},
    {"id": 29, "text": "希望你已经知道规则，否则你完蛋了，现在选择"},
    {"id": 30, "text": "请输入你想扔掉的牌号（从0到 {max_index}），想好了吗？: "},
    {"id": 31, "text": "错误选择，再试一次（从0到 {max_index}），你在干什么: "},
    {"id": 32, "text": "你不能出 {color} 以外的花色，笨蛋。选择 {choices}: "},
    {"id": 33, "text": "做出选择 1/0（1-我要加注，0-我认怂）: "},
    {"id": 34, "text": "选错了，好好选（1/0），你识字吗: "},
    {"id": 35, "text": "选择要送给可怜的 {opponent.name} 的牌号: "},
    {"id": 36, "text": "发现保存的游戏！你想继续你未完成的悲剧吗？(t/n): "},
    {"id": 37, "text": "机器人模式 - 0，人类互相折磨模式 - 1: "},
    {"id": 38, "text": "选错了，选0-机器人模式，1-人类折磨模式，你在想什么: "},
    {"id": 39, "text": "给自己起个名字，让大家记住你的失败"},
    {"id": 40, "text": "选择语言（pl/en），中文还没准备好: "},
    {"id": 41, "text": "宣布了婚姻 {color}，浪漫！"}
  ]
}